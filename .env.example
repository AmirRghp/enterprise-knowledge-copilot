# Local backend configuration. Load explicitly from repository root.
# Never prefix private credentials with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe:latest
# Live-checked model digest; a mismatch fails closed before embedding.
OLLAMA_EMBED_DIGEST=ff9c2f10ef5e
EMBEDDING_DIMENSION=768
EMBEDDING_MAX_TOKENS=400
EMBEDDING_TRUNCATE=false

# Existing rag-postgres server; use the isolated project application database.
# Supply an application-only account, not the existing service superuser.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=enterprise_knowledge_copilot
DB_USER=enterprise_knowledge_copilot
DB_PASSWORD=

RERANK_ENABLED=false
RERANK_PROVIDER=openrouter
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8000
SESSION_TTL_SECONDS=28800
LOGIN_RATE_PAIR_LIMIT=5
LOGIN_RATE_IP_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_RATE_MAX_KEYS=10000
SEED_EMPLOYEE_PASSWORD=
SEED_MANAGER_PASSWORD=
