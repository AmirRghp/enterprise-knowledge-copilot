# Shared local and Docker Compose configuration. Keep .env private.
# Never prefix private credentials with NEXT_PUBLIC_.
# Provider connections are configured only in /manager/providers, never imported.
# Generate a stable Fernet key using the README setup step; back it up separately.
APP_ENCRYPTION_KEY=

# Docker Compose fresh install: PostgreSQL is published on localhost:5434 by default.
# Internal services connect to postgres:5432. These credentials belong to this new DB.
POSTGRES_HOST_PORT=5434
# PostgreSQL bootstrap account; used only when the Compose volume is first created.
POSTGRES_PASSWORD=
# Restricted application role. Use a fresh value for Compose, or your role's value for native.
DB_PASSWORD=

# Native run.sh uses DB_* defaults from the app. Add DB_HOST/DB_PORT/DB_NAME/DB_USER
# here only when your native PostgreSQL connection differs from those defaults.
# Compose sets those four connection values itself and ignores them from this file.

WEB_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
LOGIN_RATE_PAIR_LIMIT=5
LOGIN_RATE_IP_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_RATE_MAX_KEYS=10000

# Upload limits (SECURITY.md section 8). Only .md and .txt, at most 1 MiB each.
UPLOAD_MAX_BYTES=1048576
UPLOAD_MAX_ACTIVE_DOCUMENTS=100
UPLOAD_MAX_CURRENT_CHUNKS=2000
# Ingestion lease (DATABASE.md section 4). The renew interval must stay below
# the lease duration, or Settings refuses to start.
INGESTION_LEASE_SECONDS=120
INGESTION_LEASE_RENEW_SECONDS=30
# Three is the ceiling the ingestion_jobs CHECK constraint allows.
INGESTION_MAX_ATTEMPTS=3
