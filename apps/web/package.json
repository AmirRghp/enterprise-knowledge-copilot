{
  "name": "enterprise-knowledge-copilot-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:proxy": "node tests/auth-proxy.mjs",
    "test:answers": "node tests/answer-proxy.mjs",
    "test:render": "node tests/answer-render.mjs",
    "test:sources": "node tests/source-proxy.mjs",
    "test:source-render": "node tests/source-render.mjs",
    "test:transitions": "node tests/source-transition.mjs",
    "test:navigation": "node tests/navigation.mjs",
    "test:providers": "node tests/provider-panel.mjs",
    "test:users": "node tests/users-panel.mjs",
    "test:documents": "node tests/documents-panel.mjs",
    "test:system-prompts": "node tests/system-prompts.mjs",
    "test:rate-limits": "node tests/rate-limits.mjs",
    "test:organization": "node tests/organization-settings.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@paper-design/shaders-react": "^0.0.81",
    "lucide-react": "1.52.0",
    "motion": "^14.3.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
